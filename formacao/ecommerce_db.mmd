erDiagram
    USER ||--o{ ADDRESS : "has"
    USER ||--o{ ORDER : "places"
    USER ||--o{ REVIEW : "writes"
    
    CATEGORY ||--o{ PRODUCT : "contains"
    PRODUCT ||--o{ PRODUCT_IMAGE : "has"
    PRODUCT ||--o{ ORDER_ITEM : "included_in"
    PRODUCT ||--o{ REVIEW : "receives"
    PRODUCT ||--o{ INVENTORY : "tracked_in"
    
    ORDER ||--|{ ORDER_ITEM : "consists_of"
    ORDER ||--|| PAYMENT : "has"
    ORDER ||--|| SHIPPING : "has"
    
    USER {
        int id PK
        string first_name
        string last_name
        string email UK
        string password
        string phone
        datetime created_at
    }

    ADDRESS {
        int id PK
        int user_id FK
        string street
        string city
        string state
        string zip_code
        string country
        boolean is_default
    }

    CATEGORY {
        int id PK
        string name
        string description
        int parent_id FK
    }

    PRODUCT {
        int id PK
        int category_id FK
        string name
        string description
        decimal price
        string sku UK
        datetime created_at
    }

    PRODUCT_IMAGE {
        int id PK
        int product_id FK
        string url
        boolean is_primary
    }

    INVENTORY {
        int id PK
        int product_id FK
        int quantity
        string location
    }

    ORDER {
        int id PK
        int user_id FK
        datetime order_date
        decimal total_amount
        string status
    }

    ORDER_ITEM {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
        decimal unit_price
    }

    PAYMENT {
        int id PK
        int order_id FK
        string payment_method
        string transaction_id
        decimal amount
        string status
        datetime payment_date
    }

    SHIPPING {
        int id PK
        int order_id FK
        string tracking_number
        string carrier
        datetime estimated_delivery
        string status
    }

    REVIEW {
        int id PK
        int user_id FK
        int product_id FK
        int rating
        string comment
        datetime created_at
    }
