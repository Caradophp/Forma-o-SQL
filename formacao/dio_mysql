# Procedure 
DELIMITER $$

CREATE PROCEDURE insert_producer (
    IN p_name VARCHAR(100)
)
BEGIN
    START TRANSACTION;

    INSERT INTO producer (name) VALUES (p_name);

    COMMIT;
END$$

DELIMITER ;

CALL insert_producer('Ufotable');


